# Contact (optional overrides — defaults are set in src/config/contact.ts)
NEXT_PUBLIC_CONTACT_COMPANY=
NEXT_PUBLIC_CONTACT_TAGLINE=
NEXT_PUBLIC_CONTACT_CATEGORY=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_PHONE_TEL=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_CONTACT_WEBSITE=
NEXT_PUBLIC_CONTACT_WEBSITE_LABEL=
NEXT_PUBLIC_CONTACT_HOURS=

# Google Maps embed URL (optional override)
NEXT_PUBLIC_MAP_EMBED_URL=

# Enquiry delivery (server-only). POST JSON payloads to this URL (Zapier, Make, custom API, etc.)
ENQUIRY_WEBHOOK_URL=
ENQUIRY_API_KEY=

# Public site URL (required in production for OG/WhatsApp previews and absolute image URLs)
NEXT_PUBLIC_SITE_URL=https://shreemcontrols.in
# Server-only alias (runtime metadata / QR if you prefer not to bake NEXT_PUBLIC_* at build time)
SITE_URL=https://shreemcontrols.in

# CMS uploads are stored under public/gallery, public/blog-covers, public/visiting-cards
# (preserve these folders on deploy; see deployment notes in project docs).

# Database & Admin Authentication
DATABASE_URL=

ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

AUTH_ACCESS_TOKEN_SECRET=
AUTH_REFRESH_TOKEN_SECRET=

AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=7d

NODE_ENV=development
