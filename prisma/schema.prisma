// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
}

enum GalleryStatus {
  PUBLISHED
  DRAFT
}

enum BlogStatus {
  ACTIVE
  INACTIVE
}

enum VisitingCardStatus {
  ACTIVE
  INACTIVE
}

model AdminUser {
  id                 String         @id @default(cuid())
  name               String
  email              String         @unique
  passwordHash       String
  role               AdminRole      @default(SUPER_ADMIN)
  isActive           Boolean        @default(true)
  isBootstrapManaged Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  lastLoginAt        DateTime?
  sessions           AdminSession[]

  @@index([email])
  @@index([isBootstrapManaged])
  @@map("admin_users")
}

model AdminSession {
  id               String     @id @default(cuid())
  adminUserId      String
  adminUser        AdminUser  @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  refreshTokenHash String     @unique
  accessTokenHash  String?
  expiresAt        DateTime
  refreshExpiresAt DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime   @default(now())
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  userAgent        String?
  ipAddress        String?

  @@index([adminUserId])
  @@index([refreshTokenHash])
  @@index([expiresAt])
  @@index([refreshExpiresAt])
  @@map("admin_sessions")
}

model GalleryImage {
  id            String        @id @default(cuid())
  title         String
  imageUrl      String
  imageFileName String        @unique
  imageMimeType String        @default("image/webp")
  imageSize     Int
  width         Int
  height        Int
  status        GalleryStatus @default(DRAFT)
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([sortOrder])
  @@index([createdAt])
  @@map("gallery_images")
}

model Blog {
  id                 String     @id @default(cuid())
  title              String
  slug               String     @unique
  excerpt            String     @db.Text
  content            String     @db.Text
  coverImage         String
  coverImageFileName String     @unique
  coverImageMimeType String     @default("image/webp")
  coverImageSize     Int        @default(0)
  status             BlogStatus @default(ACTIVE)
  metaTitle          String?
  metaDescription    String?    @db.Text
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([status])
  @@index([slug])
  @@index([createdAt])
  @@map("blogs")
}

model VisitingCard {
  id                     String             @id @default(cuid())
  slug                   String             @unique
  fullName               String
  designation            String?
  department             String?
  shortDescription       String?            @db.Text
  profilePhotoUrl        String?
  profilePhotoFileName   String?            @unique
  profilePhotoMimeType   String?
  profilePhotoSize       Int                @default(0)
  companyName            String?
  companyLogoUrl         String?
  companyLogoFileName    String?            @unique
  companyLogoMimeType    String?
  companyLogoSize        Int                @default(0)
  companyWebsite         String?
  companyAddress         String?            @db.Text
  phone                  String?
  whatsapp               String?
  email                  String?
  altPhone               String?
  socialLinks            Json               @default("[]")
  sortOrder              Int                @default(0)
  status                 VisitingCardStatus @default(INACTIVE)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([status])
  @@index([sortOrder])
  @@index([fullName])
  @@index([companyName])
  @@index([createdAt])
  @@map("visiting_cards")
}
